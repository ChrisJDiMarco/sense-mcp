{
  "name": "sense-mcp",
  "version": "0.1.0",
  "description": "A local-first MCP context broker for bounded, consent-gated situational awareness.",
  "license": "MIT",
  "author": "Chris DiMarco",
  "type": "module",
  "bin": {
    "sense-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ChrisJDiMarco/sense-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ChrisJDiMarco/sense-mcp/issues"
  },
  "homepage": "https://github.com/ChrisJDiMarco/sense-mcp#readme",
  "files": [
    "dist",
    "CHANGELOG.md",
    "CONTRIBUTING.md",
    "ROADMAP.md",
    "SECURITY.md",
    "SPEC.md",
    "docs/**/*.md",
    "examples"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "smoke": "node scripts/smoke.cjs",
    "eval:routing": "node scripts/eval-routing.cjs",
    "eval:prompt-pack": "node scripts/eval-prompt-pack.cjs",
    "ios:build": "xcodebuild -project apps/ios/SenseIOS/SenseIOS.xcodeproj -scheme SenseIOS -configuration Debug -sdk iphonesimulator -destination 'generic/platform=iOS Simulator' build",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "audit:all": "npm audit --audit-level=moderate",
    "check:package": "node scripts/check-package.cjs",
    "check": "npm run build && npm run test:coverage && npm run eval:routing && npm run eval:prompt-pack && npm run audit:prod && npm run audit:all",
    "release:dry-run": "npm run check && npm run check:package",
    "prepublishOnly": "npm run check"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "context",
    "presence",
    "ambient",
    "sensors",
    "local-first",
    "privacy",
    "claude",
    "ai"
  ],
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@vitest/coverage-v8": "^4.1.10",
    "tsx": "^4.23.1",
    "typescript": "^5.4.0",
    "vitest": "^4.1.10"
  }
}
